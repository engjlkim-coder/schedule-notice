rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // 작성 권한이 등록된 기기(익명 로그인 uid)인지
    function isWriter() {
      return signedIn()
        && exists(/databases/$(database)/documents/writers/$(request.auth.uid));
    }

    function validAnnouncement(d) {
      return d.keys().hasOnly(['date', 'time', 'targets', 'title', 'message', 'author', 'createdAt', 'status'])
        && d.keys().hasAll(['date', 'time', 'targets', 'message', 'status'])
        && d.status == 'pending'
        && d.date is string && d.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && d.time is string && d.time.matches('^[0-9]{2}:[0-9]{2}$')
        && d.targets is list && d.targets.size() >= 1 && d.targets.size() <= 30
        && d.message is string && d.message.size() >= 1 && d.message.size() <= 500
        && (!('title' in d) || (d.title is string && d.title.size() <= 60))
        && (!('author' in d) || (d.author is string && d.author.size() <= 20))
        && (!('createdAt' in d) || d.createdAt == request.time);
    }

    // 작성 비밀번호 (콘솔에서 직접 만드는 문서: config/auth { pin: "..." }) - 앱에서는 읽을 수 없음
    match /config/{docId} {
      allow read, write: if false;
    }

    // 작성 권한 등록: 비밀번호가 맞을 때만 내 uid로 문서를 만들 수 있음
    match /writers/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list: if false;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['pin'])
        && request.resource.data.pin == get(/databases/$(database)/documents/config/auth).data.pin;
      allow update, delete: if false;
    }

    // 푸시 토큰: 기기(uid) 본인만 자기 문서를 쓰고 지울 수 있고, 앱에서는 읽을 수 없음
    match /tokens/{uid} {
      allow read: if false;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'token', 'updatedAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 20
        && request.resource.data.token is string
        && request.resource.data.token.size() < 1000;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // 공지: 누구나(앱 사용자) 읽기, 작성 권한자만 올리기/삭제 (상태 변경은 서버 스크립트만 가능)
    match /announcements/{id} {
      allow read: if signedIn();
      allow create: if isWriter() && validAnnouncement(request.resource.data);
      allow update: if false;
      allow delete: if isWriter();
    }
  }
}
